---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/Footer.astro';
import Nav from '../../components/Nav.astro';
import { formatDate } from '../../lib/format';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout
  title="日志 · LOST IN ORBIT"
  description="关于工程、工具与在轨道上构建东西的笔记。"
>
  <Nav />
  <main id="main" class="relative min-h-screen overflow-hidden pt-[var(--nav-height)]">
    <div class="pointer-events-none absolute inset-0 -z-10">
      <div class="absolute top-0 right-0 h-[34rem] w-[34rem] translate-x-1/3 -translate-y-1/3 rounded-full bg-hud/[0.06] blur-[100px]"></div>
      <div class="absolute bottom-0 left-0 h-[26rem] w-[26rem] -translate-x-1/3 translate-y-1/3 rounded-full bg-ember/[0.05] blur-[100px]"></div>
      <div class="absolute inset-0 bg-[linear-gradient(rgba(233,237,255,.025)_1px,transparent_1px),linear-gradient(90deg,rgba(233,237,255,.025)_1px,transparent_1px)] bg-[size:72px_72px] [mask-image:linear-gradient(to_bottom,black,transparent_80%)]"></div>
    </div>

    <div class="shell py-16 md:py-24">
      <a href="/" class="group inline-flex items-center gap-2 font-mono text-[0.76rem] tracking-[0.14em] text-ink-faint transition-colors hover:text-hud">
        <span class="transition-transform group-hover:-translate-x-0.5">←</span> BACK TO ORBIT
      </a>

      <div class="mt-12 flex flex-col gap-6 border-b border-white/8 pb-12 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="eyebrow">TRANSMISSIONS // LOG</p>
          <h1 class="mt-5 text-4xl font-medium tracking-[-0.05em] text-ink md:text-6xl">日志</h1>
          <p class="mt-5 max-w-xl text-sm leading-7 text-ink-dim">
            关于工程、工具、失败实验和偶尔有效的直觉。写在轨道上，不一定准时。
          </p>
        </div>
        <a href="/rss.xml" class="inline-flex items-center gap-2 font-mono text-[0.76rem] tracking-[0.12em] text-ink-faint transition-colors hover:text-hud">
          SUBSCRIBE VIA RSS <span aria-hidden="true">↗</span>
        </a>
      </div>

      {posts.length > 0 ? (
        <div class="mt-2">
          {posts.map((post, index) => (
            <a
              href={`/blog/${post.id}/`}
              class="group grid gap-5 border-b border-white/8 py-9 transition-colors hover:border-hud/25 md:grid-cols-[7rem_1fr_auto] md:items-start md:gap-8"
            >
              <div class="flex items-center gap-3 md:block">
                <p class="font-mono text-[0.75rem] tracking-[0.1em] text-ink-faint">{formatDate(post.data.date)}</p>
                <p class="mt-0 font-mono text-[0.68rem] tracking-[0.16em] text-hud/75 md:mt-2">LOG // {String(index + 1).padStart(2, '0')}</p>
              </div>
              <div>
                <h2 class="text-xl font-medium tracking-[-0.02em] text-ink transition-colors group-hover:text-hud md:text-2xl">
                  {post.data.title}
                </h2>
                <p class="mt-2 max-w-2xl text-sm leading-7 text-ink-dim">{post.data.description}</p>
                <div class="mt-4 flex flex-wrap gap-2">
                  {post.data.tags.map((tag) => (
                    <span class="rounded-full border border-white/8 px-2.5 py-1 font-mono text-[0.65rem] tracking-[0.04em] text-ink-faint">{tag}</span>
                  ))}
                </div>
              </div>
              <span class="grid size-10 place-items-center rounded-full border border-white/10 text-ink-faint transition-all group-hover:border-hud/40 group-hover:text-hud">
                <svg viewBox="0 0 14 14" class="size-3.5" fill="none" aria-hidden="true">
                  <path d="M3 11 11 3M5 3h6v6" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
            </a>
          ))}
        </div>
      ) : (
        <p class="py-20 text-sm text-ink-dim">第一段信号还在路上。</p>
      )}
    </div>
  </main>
  <Footer />
</BaseLayout>
