---
import { site } from '../data/site';
import { getHomeCopy, type Locale } from '../i18n/home';

interface Props {
  locale?: Locale;
}

const { locale = 'zh' } = Astro.props;
const copy = getHomeCopy(locale);
const isEnglish = locale === 'en';
const home = isEnglish ? '/en/' : '/';
const alternate = isEnglish ? '/' : '/en/';
const navItems = [
  { label: copy.nav.work, href: isEnglish ? '/en/#work' : '/#work' },
  { label: copy.nav.writing, href: '/blog/' },
  { label: copy.nav.about, href: isEnglish ? '/en/#about' : '/#about' },
];
const navLabel = isEnglish ? 'Main navigation' : '主导航';
const menuLabel = isEnglish ? 'Open menu' : '打开菜单';
---

<header class="nav-shell fixed inset-x-0 top-0 z-50 border-b border-white/[0.06] bg-space-950/55 backdrop-blur-xl">
  <div class="shell flex h-[var(--nav-height)] items-center justify-between gap-3">
    <a href={home} class="group flex items-center gap-3">
      <span class="relative grid size-9 place-items-center rounded-full border border-hud/35 bg-hud/[0.06]">
        <svg viewBox="0 0 32 32" class="size-5 text-hud" fill="none" aria-hidden="true">
          <ellipse cx="16" cy="16" rx="13" ry="5.5" stroke="currentColor" stroke-width="1.2" transform="rotate(-28 16 16)" opacity=".75" />
          <circle cx="16" cy="16" r="5.2" stroke="currentColor" stroke-width="1.2" />
          <circle cx="27" cy="10.5" r="1.8" fill="currentColor" />
        </svg>
        <span class="absolute inset-0 rounded-full border border-hud/20 blur-[2px]"></span>
      </span>
      <span class="flex flex-col leading-none">
        <span class="font-mono text-[0.84rem] font-medium tracking-[0.24em] text-ink">LOST<span class="mx-1 text-hud">//</span>ORBIT</span>
        <span class="mt-1 text-[0.76rem] tracking-[0.18em] text-ink-faint">PERSONAL LAB</span>
      </span>
    </a>

    <nav class="hidden items-center gap-6 md:flex" aria-label={navLabel}>
      {navItems.map((item) => (
        <a
          href={item.href}
          class="nav-link font-mono text-[0.84rem] tracking-[0.16em] text-ink-dim transition-colors hover:text-hud"
        >
          {item.label}
        </a>
      ))}
      <a
        href={alternate}
        class="nav-lang font-mono text-[0.78rem] tracking-[0.12em] text-ink-faint transition-colors hover:text-hud"
        aria-label={`${copy.nav.language} — ${copy.nav.languageLabel}`}
        hreflang={isEnglish ? 'zh-CN' : 'en'}
      >
        {copy.nav.language}
      </a>
      <button
        type="button"
        class="nav-theme grid size-9 place-items-center rounded-full border border-white/12 text-ink-dim transition-colors hover:border-hud/50 hover:text-hud"
        data-theme-toggle
        aria-label={copy.nav.theme}
        aria-pressed="false"
      >
        <svg class="theme-icon theme-icon-sun size-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <circle cx="10" cy="10" r="3.4" stroke="currentColor" stroke-width="1.25" />
          <path d="M10 2v2M10 16v2M2 10h2M16 10h2M4.35 4.35l1.4 1.4M14.25 14.25l1.4 1.4M15.65 4.35l-1.4 1.4M5.75 14.25l-1.4 1.4" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" />
        </svg>
        <svg class="theme-icon theme-icon-moon size-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M16.2 12.4A6.7 6.7 0 0 1 7.6 3.8 6.8 6.8 0 1 0 16.2 12.4Z" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round" />
        </svg>
      </button>
      <a
        href={site.github}
        target="_blank"
        rel="noreferrer"
        class="nav-github group inline-flex items-center gap-2 rounded-full border border-white/12 px-3.5 py-2 font-mono text-[0.8rem] tracking-[0.12em] text-ink transition-colors hover:border-hud/50 hover:text-hud"
      >
        {copy.nav.github}
        <svg viewBox="0 0 12 12" class="size-2.5 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5" fill="none" aria-hidden="true">
          <path d="M2.5 9.5 9.5 2.5M4 2.5h5.5V8" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </nav>

    <div class="flex items-center gap-2 md:hidden">
      <button
        type="button"
        class="nav-theme grid size-10 place-items-center rounded-full border border-white/12 text-ink-dim transition-colors hover:border-hud/50 hover:text-hud"
        data-theme-toggle
        aria-label={copy.nav.theme}
        aria-pressed="false"
      >
        <svg class="theme-icon theme-icon-sun size-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <circle cx="10" cy="10" r="3.4" stroke="currentColor" stroke-width="1.25" />
          <path d="M10 2v2M10 16v2M2 10h2M16 10h2M4.35 4.35l1.4 1.4M14.25 14.25l1.4 1.4M15.65 4.35l-1.4 1.4M5.75 14.25l-1.4 1.4" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" />
        </svg>
        <svg class="theme-icon theme-icon-moon size-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M16.2 12.4A6.7 6.7 0 0 1 7.6 3.8 6.8 6.8 0 1 0 16.2 12.4Z" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round" />
        </svg>
      </button>

      <details class="group relative">
        <summary
          class="grid size-10 cursor-pointer list-none place-items-center rounded-full border border-white/12 text-ink transition-colors hover:border-hud/50 hover:text-hud [&::-webkit-details-marker]:hidden"
          aria-label={menuLabel}
        >
          <svg viewBox="0 0 20 20" class="size-4" fill="none" aria-hidden="true">
            <path class="group-open:hidden" d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
            <path class="hidden group-open:block" d="m5 5 10 10M15 5 5 15" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
          </svg>
        </summary>
        <div class="nav-mobile-panel absolute top-12 right-0 w-56 overflow-hidden rounded-2xl border border-white/10 bg-space-900/95 p-2 shadow-2xl backdrop-blur-xl">
          {navItems.map((item) => (
            <a href={item.href} class="block rounded-xl px-4 py-3 font-mono text-xs tracking-[0.12em] text-ink-dim hover:bg-white/5 hover:text-hud">
              {item.label}
            </a>
          ))}
          <a href={alternate} class="block rounded-xl px-4 py-3 font-mono text-xs tracking-[0.12em] text-ink-faint hover:bg-white/5 hover:text-hud" aria-label={`${copy.nav.language} — ${copy.nav.languageLabel}`} hreflang={isEnglish ? 'zh-CN' : 'en'}>
            {copy.nav.language}
          </a>
          <a href={site.github} target="_blank" rel="noreferrer" class="mt-1 flex items-center justify-between rounded-xl border-t border-white/8 px-4 py-3 font-mono text-xs tracking-[0.12em] text-hud">
            {copy.nav.github} <span aria-hidden="true">↗</span>
          </a>
        </div>
      </details>
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const buttons = document.querySelectorAll('[data-theme-toggle]');
    const sync = () => {
      const theme = root.dataset.theme === 'light' ? 'light' : 'dark';
      buttons.forEach((button) => button.setAttribute('aria-pressed', String(theme === 'light')));
      const meta = document.querySelector('meta[name="theme-color"]');
      if (meta) meta.setAttribute('content', theme === 'light' ? '#f6f2e9' : '#03050c');
    };
    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const next = root.dataset.theme === 'light' ? 'dark' : 'light';
        root.dataset.theme = next;
        root.style.colorScheme = next;
        try { localStorage.setItem('orbit-theme', next); } catch {}
        sync();
      });
    });
    sync();
  })();
</script>
