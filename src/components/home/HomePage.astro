---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../Footer.astro';
import Nav from '../Nav.astro';
import ProjectGrid from '../ProjectGrid.astro';
import SectionHeading from '../SectionHeading.astro';
import SpaceScene from '../scene/SpaceScene.astro';
import { site } from '../../data/site';
import { formatDate } from '../../lib/format';
import { getHomeCopy, type Locale } from '../../i18n/home';

interface Props {
  locale?: Locale;
}

const { locale = 'zh' } = Astro.props;
const copy = getHomeCopy(locale);
const isEnglish = locale === 'en';
const lang = isEnglish ? 'en' : 'zh-CN';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);

const alternates = [
  { hreflang: 'zh-CN', href: '/' },
  { hreflang: 'en', href: '/en/' },
  { hreflang: 'x-default', href: '/' },
];
---

<BaseLayout
  lang={lang}
  title={copy.meta.title}
  description={copy.meta.description}
  image={isEnglish ? '/og-en.png' : '/og.png'}
  imageAlt={isEnglish ? 'LOST IN ORBIT — Personal Lab' : 'LOST IN ORBIT — 个人主页'}
  skipLabel={isEnglish ? 'Skip to content' : '跳到主要内容'}
  alternates={alternates}
>
  <Nav locale={locale} />
  <main id="main">
    <SpaceScene locale={locale} />

    <section id="about" class="relative scroll-mt-20 overflow-hidden border-t border-white/[0.06] py-20 md:py-32">
      <div class="pointer-events-none absolute inset-0 -z-10">
        <div class="absolute top-1/3 -left-40 h-96 w-96 rounded-full bg-hud/[0.045] blur-[110px]"></div>
        <div class="absolute right-0 bottom-0 h-80 w-80 translate-x-1/3 rounded-full bg-ember/[0.04] blur-[100px]"></div>
        <div class="absolute inset-0 bg-[linear-gradient(rgba(233,237,255,.018)_1px,transparent_1px),linear-gradient(90deg,rgba(233,237,255,.018)_1px,transparent_1px)] bg-[size:64px_64px] [mask-image:radial-gradient(ellipse_80%_70%_at_50%_40%,black,transparent)]"></div>
      </div>

      <div class="shell">
        <SectionHeading
          index="01"
          eyebrow={copy.about.eyebrow}
          title={copy.about.title}
          description={copy.about.description}
        />

        <div class="mt-14 grid gap-10 lg:mt-20 lg:grid-cols-[1.12fr_0.88fr] lg:gap-16">
          <div>
            <div class="max-w-2xl space-y-5 text-sm leading-8 text-ink-dim md:text-base md:leading-9">
              {copy.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            </div>

            <div class="mt-10 grid grid-cols-3 gap-4 border-y border-white/[0.07] py-7">
              {copy.about.stats.map((stat) => (
                <div>
                  <p class="font-mono text-2xl tracking-[-0.04em] text-ink md:text-4xl">{stat.value}</p>
                  <p class="mt-2 font-mono text-[0.68rem] tracking-[0.1em] text-ink-faint uppercase md:text-[0.72rem]">{stat.label}</p>
                </div>
              ))}
            </div>

            <div class="mt-8 flex flex-wrap gap-2">
              {site.focus.map((item) => (
                <span class="rounded-full border border-white/10 px-3 py-1.5 font-mono text-[0.72rem] tracking-[0.06em] text-ink-dim">{item}</span>
              ))}
            </div>
          </div>

          <aside class="glass-panel hud-corners relative self-start rounded-2xl p-6 md:p-7">
            <div class="flex items-center justify-between gap-4 border-b border-white/[0.08] pb-5">
              <p class="font-mono text-[0.72rem] tracking-[0.18em] text-hud/70">{copy.about.telemetry}</p>
              <span class="inline-flex items-center gap-2 font-mono text-[0.68rem] tracking-[0.1em] text-hud/75">
                <span class="size-1.5 animate-pulse rounded-full bg-hud"></span> {copy.about.online}
              </span>
            </div>

            <dl class="divide-y divide-white/[0.06]">
              <div class="grid grid-cols-[5.5rem_1fr] gap-4 py-4">
                <dt class="font-mono text-[0.68rem] tracking-[0.12em] text-ink-faint">{copy.about.nowLabel}</dt>
                <dd class="text-sm leading-6 text-ink">{copy.about.nowText}</dd>
              </div>
              <div class="grid grid-cols-[5.5rem_1fr] gap-4 py-4">
                <dt class="font-mono text-[0.68rem] tracking-[0.12em] text-ink-faint">{copy.about.buildingLabel}</dt>
                <dd class="text-sm leading-6 text-ink-dim">
                  <span class="text-ink">larkline</span> · <span class="text-ink">coffer-desktop</span> · <span class="text-ink">octra</span>
                </dd>
              </div>
              <div class="grid grid-cols-[5.5rem_1fr] gap-4 py-4">
                <dt class="font-mono text-[0.68rem] tracking-[0.12em] text-ink-faint">{copy.about.baseLabel}</dt>
                <dd class="text-sm leading-6 text-ink-dim">{copy.about.baseText}</dd>
              </div>
              <div class="grid grid-cols-[5.5rem_1fr] gap-4 py-4">
                <dt class="font-mono text-[0.68rem] tracking-[0.12em] text-ink-faint">{copy.about.signalLabel}</dt>
                <dd class="text-sm leading-6 text-ink-dim">{copy.about.signalText}</dd>
              </div>
            </dl>

            <a href={site.github} target="_blank" rel="noreferrer" class="group mt-2 flex items-center justify-between rounded-xl border border-hud/20 bg-hud/[0.04] px-4 py-3 font-mono text-[0.75rem] tracking-[0.1em] text-hud transition-colors hover:border-hud/45 hover:bg-hud/[0.08]">
              {copy.about.channel}
              <span class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">↗</span>
            </a>
          </aside>
        </div>
      </div>
    </section>

    <section id="work" class="relative scroll-mt-20 overflow-hidden border-t border-white/[0.06] bg-space-900/50 py-20 md:py-32">
      <div class="pointer-events-none absolute inset-0 -z-10">
        <div class="absolute top-0 right-0 h-[28rem] w-[28rem] rounded-full bg-ember/[0.04] blur-[110px]"></div>
        <div class="absolute bottom-1/4 left-0 h-80 w-80 rounded-full bg-hud/[0.035] blur-[110px]"></div>
      </div>

      <div class="shell">
        <SectionHeading
          index="02"
          eyebrow={copy.work.eyebrow}
          title={copy.work.title}
          description={copy.work.description}
        />
        <div class="mt-12 md:mt-16">
          <ProjectGrid locale={locale} />
        </div>
        <p class="mt-6 flex items-center gap-3 font-mono text-[0.68rem] tracking-[0.1em] text-ink-faint">
          <span class="h-px w-8 bg-hud/35"></span>
          {copy.project.snapshot}
        </p>
      </div>
    </section>

    <section id="writing" class="relative scroll-mt-20 overflow-hidden border-t border-white/[0.06] py-20 md:py-32">
      <div class="pointer-events-none absolute inset-0 -z-10">
        <div class="absolute inset-0 bg-[linear-gradient(rgba(233,237,255,.016)_1px,transparent_1px),linear-gradient(90deg,rgba(233,237,255,.016)_1px,transparent_1px)] bg-[size:64px_64px] [mask-image:linear-gradient(to_bottom,black,transparent_85%)]"></div>
      </div>

      <div class="shell">
        <SectionHeading
          index="03"
          eyebrow={copy.writing.eyebrow}
          title={copy.writing.title}
          description={copy.writing.description}
        />
        {isEnglish && (
          <p class="mt-5 font-mono text-[0.72rem] tracking-[0.08em] text-hud/70">{copy.writing.note}</p>
        )}

        <div class="mt-12 grid gap-10 lg:grid-cols-[1fr_20rem] lg:gap-14">
          <div class="border-t border-white/[0.08]">
            {posts.map((post, index) => (
              <a
                href={`/blog/${post.id}/`}
                class="group grid gap-4 border-b border-white/[0.08] py-7 md:grid-cols-[7rem_1fr_auto] md:items-start md:gap-7"
                lang={isEnglish ? 'zh-CN' : undefined}
              >
                <div>
                  <p class="font-mono text-[0.72rem] tracking-[0.06em] text-ink-faint">{formatDate(post.data.date, locale)}</p>
                  <p class="mt-1.5 font-mono text-[0.65rem] tracking-[0.14em] text-hud/75">LOG // {String(index + 1).padStart(2, '0')}</p>
                </div>
                <div>
                  <h3 class="text-lg font-medium tracking-[-0.02em] text-ink transition-colors group-hover:text-hud md:text-xl">
                    {post.data.title}
                  </h3>
                  <p class="mt-2 max-w-xl text-sm leading-7 text-ink-dim">{post.data.description}</p>
                  <div class="mt-3 flex flex-wrap gap-2">
                    {post.data.tags.slice(0, 3).map((tag) => (
                      <span class="font-mono text-[0.625rem] tracking-[0.06em] text-ink-faint">#{tag}</span>
                    ))}
                  </div>
                </div>
                <span class="hidden size-9 place-items-center rounded-full border border-white/10 text-ink-faint transition-all group-hover:border-hud/40 group-hover:text-hud md:grid">
                  <svg viewBox="0 0 14 14" class="size-3" fill="none" aria-hidden="true">
                    <path d="M3 11 11 3M5 3h6v6" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
              </a>
            ))}

            <a href="/blog/" class="group mt-7 inline-flex items-center gap-2 font-mono text-[0.75rem] tracking-[0.12em] text-hud/80 transition-colors hover:text-hud">
              {copy.writing.all}
              <span class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">→</span>
            </a>
          </div>

          <aside class="relative overflow-hidden rounded-2xl border border-white/[0.09] bg-white/[0.025] p-6">
            <div class="pointer-events-none absolute -top-16 -right-16 size-48 rounded-full border border-hud/10"></div>
            <div class="pointer-events-none absolute -top-10 -right-10 size-32 rounded-full border border-dashed border-hud/15"></div>
            <p class="font-mono text-[0.7rem] tracking-[0.18em] text-hud/80">{copy.writing.rssEyebrow}</p>
            <p class="mt-4 text-lg font-medium leading-7 tracking-[-0.02em] text-ink">{copy.writing.rssTitle}</p>
            <p class="mt-2 text-sm leading-7 text-ink-dim">{copy.writing.rssBody}</p>
            <a href="/rss.xml" class="mt-6 inline-flex items-center gap-2 rounded-full border border-white/12 px-4 py-2 font-mono text-[0.72rem] tracking-[0.1em] text-ink-dim transition-colors hover:border-hud/40 hover:text-hud">
              {copy.writing.rssButton} <span aria-hidden="true">↗</span>
            </a>
          </aside>
        </div>
      </div>
    </section>

    <section id="contact" class="relative overflow-hidden border-t border-white/[0.06] py-20 md:py-28">
      <div class="shell">
        <div class="contact-panel relative overflow-hidden rounded-3xl border border-white/[0.09] bg-[linear-gradient(120deg,rgba(22,32,64,.7),rgba(5,7,15,.9))] px-6 py-12 md:px-12 md:py-16">
          <div class="pointer-events-none absolute -top-40 -right-24 size-[30rem] rounded-full border border-hud/10"></div>
          <div class="pointer-events-none absolute -top-24 -right-10 size-[20rem] rounded-full border border-dashed border-hud/15"></div>
          <div class="pointer-events-none absolute -top-20 right-24 size-2 rounded-full bg-hud/60 shadow-[0_0_18px_4px_rgba(125,227,224,.25)]"></div>
          <div class="relative max-w-2xl">
            <p class="eyebrow">{copy.contact.eyebrow}</p>
            <h2 class="mt-5 text-balance text-3xl font-medium leading-[1.1] tracking-[-0.045em] text-ink md:text-5xl">
              {copy.contact.title}
            </h2>
            <p class="mt-5 max-w-xl text-sm leading-8 text-ink-dim">{copy.contact.body}</p>
            <div class="mt-8 flex flex-wrap gap-3">
              <a href={site.github} target="_blank" rel="noreferrer" class="inline-flex items-center gap-2 rounded-full bg-hud px-5 py-2.5 font-mono text-[0.78rem] font-semibold tracking-[0.08em] text-space-950 transition-transform hover:-translate-y-0.5">
                {copy.contact.github} <span aria-hidden="true">↗</span>
              </a>
              <a href="/rss.xml" class="inline-flex items-center gap-2 rounded-full border border-white/12 px-5 py-2.5 font-mono text-[0.78rem] tracking-[0.08em] text-ink-dim transition-colors hover:border-hud/40 hover:text-hud">
                {copy.contact.rss} <span aria-hidden="true">↗</span>
              </a>
            </div>
            <p class="mt-9 font-mono text-[0.68rem] tracking-[0.12em] text-ink-faint">
              {copy.contact.coordinates}
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer locale={locale} />
</BaseLayout>
