---
import { site } from '../data/site';
import { getHomeCopy, type Locale } from '../i18n/home';

interface Props {
  locale?: Locale;
}

const { locale = 'zh' } = Astro.props;
const copy = getHomeCopy(locale).footer;
const year = new Date().getFullYear();
---

<footer class="relative overflow-hidden border-t border-white/[0.06] bg-space-950">
  <div class="pointer-events-none absolute -top-24 left-1/2 h-64 w-[42rem] -translate-x-1/2 rounded-full bg-hud/[0.05] blur-[90px]"></div>
  <div class="shell relative py-14">
    <div class="flex flex-col gap-10 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="eyebrow">{copy.eyebrow}</p>
        <p class="mt-5 max-w-md text-2xl font-medium tracking-[-0.03em] text-ink md:text-3xl">
          {copy.title}
        </p>
        <p class="mt-3 max-w-md text-sm leading-7 text-ink-dim">{copy.body}</p>
      </div>
      <div class="flex flex-wrap items-center gap-3">
        <a href={site.github} target="_blank" rel="noreferrer" class="inline-flex items-center gap-2 rounded-full bg-hud px-5 py-2.5 font-mono text-[0.86rem] font-semibold tracking-[0.1em] text-space-950 transition-transform hover:-translate-y-0.5">
          GITHUB <span aria-hidden="true">↗</span>
        </a>
        <a href="/rss.xml" class="inline-flex items-center gap-2 rounded-full border border-white/12 px-5 py-2.5 font-mono text-[0.86rem] tracking-[0.1em] text-ink-dim transition-colors hover:border-hud/40 hover:text-hud">
          RSS
        </a>
      </div>
    </div>

    <div class="mt-14 flex flex-col gap-4 border-t border-white/[0.06] pt-6 text-[0.84rem] text-ink-faint md:flex-row md:items-center md:justify-between">
      <p class="font-mono tracking-[0.08em]">© {year} LOST IN ORBIT · {copy.built}</p>
      <div class="flex items-center gap-5 font-mono tracking-[0.08em]">
        <span>ASTRO + TAILWIND</span>
        <a href="#top" class="transition-colors hover:text-hud">{copy.back}</a>
      </div>
    </div>
  </div>
</footer>
