---
---

<div class="planet planet-kepler" data-planet="kepler" aria-hidden="true">
  <svg viewBox="0 0 760 760" class="planet-svg" fill="none">
    <defs>
      <radialGradient id="keplerBody" cx=".34" cy=".28" r=".78">
        <stop offset="0" stop-color="#ffd49a" />
        <stop offset=".24" stop-color="#e7a35f" />
        <stop offset=".55" stop-color="#b86545" />
        <stop offset=".78" stop-color="#71363c" />
        <stop offset="1" stop-color="#2b1525" />
      </radialGradient>
      <radialGradient id="keplerShade" cx=".72" cy=".72" r=".72">
        <stop offset=".25" stop-color="#06070f" stop-opacity="0" />
        <stop offset=".7" stop-color="#06070f" stop-opacity=".45" />
        <stop offset="1" stop-color="#02030a" stop-opacity=".92" />
      </radialGradient>
      <linearGradient id="ringBack" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#ffd8a4" stop-opacity=".08" />
        <stop offset=".22" stop-color="#ffca88" stop-opacity=".5" />
        <stop offset=".5" stop-color="#f0b279" stop-opacity=".72" />
        <stop offset=".78" stop-color="#a96e58" stop-opacity=".4" />
        <stop offset="1" stop-color="#ffd8a4" stop-opacity=".06" />
      </linearGradient>
      <linearGradient id="ringFront" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#ffe3ba" stop-opacity=".16" />
        <stop offset=".3" stop-color="#ffcf96" stop-opacity=".72" />
        <stop offset=".55" stop-color="#e6a26b" stop-opacity=".62" />
        <stop offset=".8" stop-color="#8e594e" stop-opacity=".32" />
        <stop offset="1" stop-color="#ffe3ba" stop-opacity=".1" />
      </linearGradient>
      <linearGradient id="keplerRim" x1=".1" y1=".1" x2=".9" y2=".9">
        <stop offset="0" stop-color="#fff0d2" stop-opacity=".95" />
        <stop offset=".4" stop-color="#ffcf96" stop-opacity=".25" />
        <stop offset="1" stop-color="#5c2f38" stop-opacity="0" />
      </linearGradient>
      <clipPath id="keplerClip">
        <circle cx="380" cy="380" r="282" />
      </clipPath>
      <clipPath id="ringFrontClip">
        <rect x="0" y="380" width="760" height="380" />
      </clipPath>
      <filter id="keplerAtmosphere" x="-25%" y="-25%" width="150%" height="150%">
        <feGaussianBlur stdDeviation="14" />
      </filter>
      <filter id="keplerSoft" x="-20%" y="-20%" width="140%" height="140%">
        <feGaussianBlur stdDeviation="3" />
      </filter>
    </defs>

    <g transform="rotate(-16 380 380)">
      <ellipse cx="380" cy="380" rx="402" ry="104" stroke="url(#ringBack)" stroke-width="34" opacity=".8" />
      <ellipse cx="380" cy="380" rx="352" ry="80" stroke="#ffd7a1" stroke-width="4" opacity=".28" />
      <ellipse cx="380" cy="380" rx="438" ry="122" stroke="#ffbd7e" stroke-width="2" opacity=".16" />
    </g>

    <circle cx="380" cy="380" r="298" fill="#f2b46f" opacity=".1" filter="url(#keplerAtmosphere)" />
    <circle cx="380" cy="380" r="282" fill="url(#keplerBody)" />
    <g clip-path="url(#keplerClip)" opacity=".62">
      <path d="M64 290c92-26 188-30 292-9 116 24 204 13 344-20v46c-138 34-236 42-352 17-98-21-190-17-284 9z" fill="#ffdcae" opacity=".24" />
      <path d="M40 360c104-30 208-24 314 1 108 25 220 14 366-28v52c-146 42-258 52-368 26-100-24-198-28-312 2z" fill="#6d3042" opacity=".36" />
      <path d="M30 438c122-28 244-20 350 8 105 27 228 12 350-32v54c-124 44-248 58-354 31-104-27-218-34-346-6z" fill="#ffd19c" opacity=".18" />
      <path d="M28 520c134-28 262-16 372 13 101 26 220 15 332-12v50c-118 30-238 40-344 14-112-28-236-40-360-10z" fill="#52263a" opacity=".28" />
      <path d="M80 230c84-22 170-20 256 1" stroke="#ffe8c9" stroke-width="6" opacity=".13" stroke-linecap="round" />
      <path d="M96 578c80-26 164-30 248-8" stroke="#ffd7a1" stroke-width="8" opacity=".1" stroke-linecap="round" />
      <ellipse cx="268" cy="276" rx="94" ry="42" fill="#ffe3bb" opacity=".08" transform="rotate(-12 268 276)" />
    </g>
    <circle cx="380" cy="380" r="282" fill="url(#keplerShade)" />
    <circle cx="380" cy="380" r="282" stroke="url(#keplerRim)" stroke-width="3" />
    <circle cx="380" cy="380" r="290" stroke="#ffd7a1" stroke-width="1.4" opacity=".18" filter="url(#keplerSoft)" />

    <g transform="rotate(-16 380 380)" clip-path="url(#ringFrontClip)">
      <ellipse cx="380" cy="380" rx="402" ry="104" stroke="url(#ringFront)" stroke-width="34" opacity=".92" />
      <ellipse cx="380" cy="380" rx="352" ry="80" stroke="#ffe2b7" stroke-width="3" opacity=".22" />
      <ellipse cx="380" cy="380" rx="438" ry="122" stroke="#ffbd7e" stroke-width="1.5" opacity=".2" />
    </g>

    <g opacity=".5">
      <circle cx="118" cy="188" r="2.2" fill="#ffe9c8" />
      <circle cx="646" cy="224" r="1.6" fill="#ffe9c8" />
      <circle cx="624" cy="568" r="2" fill="#ffd7a1" />
      <circle cx="186" cy="608" r="1.3" fill="#ffe9c8" />
    </g>
  </svg>
</div>
