---
---

<div class="planet planet-moon" data-planet="moon" aria-hidden="true">
  <svg viewBox="0 0 260 260" class="planet-svg" fill="none">
    <defs>
      <radialGradient id="moonBody" cx=".36" cy=".3" r=".78">
        <stop offset="0" stop-color="#d8e4fa" />
        <stop offset=".4" stop-color="#8fa4c9" />
        <stop offset=".74" stop-color="#4b5c7e" />
        <stop offset="1" stop-color="#1a2237" />
      </radialGradient>
      <radialGradient id="moonShade" cx=".68" cy=".7" r=".72">
        <stop offset=".2" stop-color="#03050c" stop-opacity="0" />
        <stop offset="1" stop-color="#03050c" stop-opacity=".85" />
      </radialGradient>
      <linearGradient id="moonRim" x1=".1" y1=".1" x2=".9" y2=".9">
        <stop offset="0" stop-color="#eff8ff" stop-opacity=".9" />
        <stop offset=".45" stop-color="#a9bede" stop-opacity=".18" />
        <stop offset="1" stop-color="#ffffff" stop-opacity="0" />
      </linearGradient>
      <clipPath id="moonClip">
        <circle cx="130" cy="130" r="78" />
      </clipPath>
      <filter id="moonGlow" x="-60%" y="-60%" width="220%" height="220%">
        <feGaussianBlur stdDeviation="9" />
      </filter>
    </defs>

    <circle cx="130" cy="130" r="92" fill="#8fb8ff" opacity=".08" filter="url(#moonGlow)" />
    <circle cx="130" cy="130" r="78" fill="url(#moonBody)" />
    <g clip-path="url(#moonClip)" fill="#28344d" opacity=".4">
      <ellipse cx="104" cy="104" rx="17" ry="12" transform="rotate(-18 104 104)" />
      <ellipse cx="146" cy="86" rx="8" ry="6" />
      <ellipse cx="92" cy="148" rx="7" ry="5" />
      <ellipse cx="128" cy="158" rx="21" ry="12" transform="rotate(12 128 158)" />
      <ellipse cx="162" cy="132" rx="5" ry="4" />
      <ellipse cx="118" cy="118" rx="4" ry="3" />
    </g>
    <g clip-path="url(#moonClip)" fill="#dbe8ff" opacity=".18">
      <ellipse cx="101" cy="99" rx="17" ry="12" transform="rotate(-18 101 99)" />
      <ellipse cx="125" cy="153" rx="21" ry="12" transform="rotate(12 125 153)" />
    </g>
    <circle cx="130" cy="130" r="78" fill="url(#moonShade)" />
    <circle cx="130" cy="130" r="78" stroke="url(#moonRim)" stroke-width="1.6" />
    <path d="M62 164c14 22 38 37 68 39" stroke="#bcd2f7" stroke-width="1" opacity=".2" />
  </svg>
</div>
