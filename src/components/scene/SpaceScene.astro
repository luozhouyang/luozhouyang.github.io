---
import '../../styles/scene.css';
import { projects } from '../../data/projects';
import { site } from '../../data/site';
import { getHomeCopy, getProjectCopy, type Locale } from '../../i18n/home';
import Astronaut from './Astronaut.astro';
import PlanetKepler from './PlanetKepler.astro';
import PlanetMoon from './PlanetMoon.astro';
import Starfield from './Starfield.astro';

interface Props {
  locale?: Locale;
}

const { locale = 'zh' } = Astro.props;
const copy = getHomeCopy(locale);

const payload = projects.map((project, index) => {
  const localized = getProjectCopy(locale, project.repoName);
  return {
  slug: project.slug,
  repo: project.repo,
  repoName: project.repoName,
  kicker: project.kicker,
  tagline: localized.tagline,
  summary: localized.summary,
  language: project.language,
  stars: project.stars,
  pushedAt: project.pushedAt,
  topics: project.topics,
  accent: project.accent,
  glyph: project.glyph,
  shape: project.shape,
  rockScale: project.rockScale,
  index,
  url: `https://github.com/${project.repo}`,
  };
});
---

<section
  class="space-scene"
  data-space-scene
  data-locale={locale}
  data-scan-label={copy.scene.scan}
  data-complete-label={copy.scene.complete}
  data-unlocked-template={copy.scene.unlockedTemplate}
  data-complete-message={copy.scene.completeMessage}
  aria-labelledby="hero-title"
>
  <div class="scene-sky" aria-hidden="true">
    <Starfield />
    <div class="orbit-map">
      <svg viewBox="0 0 1000 1000" preserveAspectRatio="none">
        <ellipse cx="240" cy="820" rx="520" ry="300" transform="rotate(-18 240 820)" />
        <ellipse cx="240" cy="820" rx="680" ry="390" transform="rotate(-18 240 820)" />
        <ellipse cx="850" cy="220" rx="300" ry="180" transform="rotate(24 850 220)" />
      </svg>
    </div>
    <PlanetKepler />
    <PlanetMoon />
    <div class="scene-vignette"></div>
    <div class="scene-grain"></div>
  </div>

  <canvas class="scene-canvas" data-scene-canvas aria-hidden="true"></canvas>
  <svg class="tether-layer" data-tether aria-hidden="true">
    <path data-tether-path d="M 0 0 C 0 0 0 0 0 0" />
  </svg>

  <div class="scene-float-layer" aria-hidden="true">
    <div class="scene-orbiter scene-orbiter-a"></div>
    <div class="scene-orbiter scene-orbiter-b"></div>
  </div>

  <Astronaut label={copy.scene.astronautLabel} />

  <svg class="card-connector" data-card-connector style="display:none" aria-hidden="true">
    <path data-card-connector-path />
    <circle data-card-connector-dot r="2.4" />
  </svg>

  <div class="scene-side-label" aria-hidden="true">
    <span>SYS.ONLINE</span>
    <span class="side-rule"></span>
    <span>29.8°N / 120.1°E</span>
  </div>

  <div class="shell">
    <div class="hero-copy">
    <p class="hero-kicker font-mono">
      <span class="inline-block size-1.5 rounded-full bg-hud shadow-[0_0_10px_2px_rgba(125,227,224,.55)]"></span>
      {copy.scene.kicker}
    </p>
    <h1 id="hero-title" class="hero-title font-medium">
      <span class="block">{copy.hero.line1}</span>
      <span class="block">{copy.hero.line2Prefix}<span class="hero-emphasis">{copy.hero.emphasis}</span>{copy.hero.line2Suffix}</span>
    </h1>
    <p class="hero-sub">{copy.hero.sub}</p>
    <div class="hero-actions">
      <a href="#work" class="btn-primary">
        {copy.hero.primary}
        <svg viewBox="0 0 14 14" class="size-3" fill="none" aria-hidden="true">
          <path d="M3 7h8M7.5 3.5 11 7l-3.5 3.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
      <a href={site.github} target="_blank" rel="noreferrer" class="btn-ghost">
        {copy.hero.github} <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="hero-focus font-mono">
      {site.focus.map((item) => <span>{item}</span>)}
    </div>
    </div>
  </div>

  <div class="hero-hud">
    <div class="hud-telemetry">
      <span class="hud-signal"><i></i> {copy.scene.system}</span>
      <span class="hud-sep"></span>
      <span>{copy.scene.gravity} <b>0.62g</b></span>
      <span class="hud-sep"></span>
      <span class="hidden sm:inline">{copy.scene.drift} <b data-velocity>0.0 px/s</b></span>
    </div>
    <div class="hud-progress">
      <div class="hud-label">
        <span>{copy.scene.files}</span>
        <b data-progress-label>00 / {String(projects.length).padStart(2, '0')}</b>
      </div>
      <div class="progress-dots" data-progress-dots aria-hidden="true">
        {projects.map(() => <span></span>)}
      </div>
    </div>
    <div class="hud-actions">
      <button type="button" class="bump-button" data-bump aria-label={`${copy.scene.bump} — ${copy.scene.bumpLabel}`}>
        <svg viewBox="0 0 16 16" class="size-3.5" fill="none" aria-hidden="true">
          <circle cx="5.6" cy="8" r="3.1" stroke="currentColor" stroke-width="1.1" />
          <circle cx="10.4" cy="8" r="3.1" stroke="currentColor" stroke-width="1.1" />
          <path d="M7.2 5.6 8.8 10.4M8.8 5.6 7.2 10.4" stroke="currentColor" stroke-width="1" stroke-linecap="round" />
        </svg>
        <span>{copy.scene.bump}</span>
      </button>
      <button type="button" class="scan-button" data-scan>
        <svg viewBox="0 0 16 16" class="size-3.5" fill="none" aria-hidden="true">
          <circle cx="8" cy="8" r="5.5" stroke="currentColor" stroke-width="1.2" />
          <circle cx="8" cy="8" r="2" fill="currentColor" />
          <path d="M8 .8v2.4M8 12.8v2.4M.8 8h2.4M12.8 8h2.4" stroke="currentColor" stroke-width="1" stroke-linecap="round" />
        </svg>
        <span data-scan-label>{copy.scene.scan}</span>
      </button>
      <button type="button" class="hud-reset" data-reset hidden>{copy.scene.reset}</button>
      <a href="#work" class="hud-archive-link">{copy.scene.archive}</a>
    </div>
    <p class="scene-hint">
      <span class="hidden md:inline">{copy.scene.hint}</span>
      <span class="md:hidden">{copy.scene.hintMobile}</span>
    </p>
  </div>

  <div class="scene-tooltip font-mono" data-rock-tooltip hidden>
    <span data-tooltip-kicker>PROJECT // 01</span>
    <b data-tooltip-title></b>
    <span class="tooltip-hint">{copy.scene.tooltipHint}</span>
  </div>

  <p class="sr-only" data-live aria-live="polite"></p>

  <div class="impact-flash" data-impact aria-hidden="true"></div>

  <div class="scene-corners" aria-hidden="true">
    <span></span><span></span><span></span><span></span>
  </div>

  <aside
    class="dossier glass-panel hud-corners"
    data-dossier
    aria-hidden="true"
    aria-labelledby="dossier-title"
    role="dialog"
    aria-modal="false"
    inert
  >
    <div class="dossier-head">
      <span class="dossier-index font-mono" data-field="index">FILE // 01</span>
      <button type="button" class="dossier-close" data-dossier-close aria-label={copy.scene.close}>
        <svg viewBox="0 0 16 16" class="size-4" fill="none" aria-hidden="true">
          <path d="m4 4 8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
        </svg>
      </button>
    </div>
    <p class="dossier-kicker font-mono" data-field="kicker">LIBRARY // RUST</p>
    <h2 id="dossier-title" class="dossier-title" data-field="title">python-string-similarity</h2>
    <p class="dossier-tagline" data-field="tagline"></p>
    <p class="dossier-summary" data-field="summary"></p>
    <dl class="dossier-meta">
      <div><dt>LANGUAGE</dt><dd data-field="language"></dd></div>
      <div><dt>STARS</dt><dd data-field="stars"></dd></div>
      <div><dt>UPDATED</dt><dd data-field="updated"></dd></div>
    </dl>
    <div class="dossier-topics" data-field="topics"></div>
    <a href="#" target="_blank" rel="noreferrer" class="dossier-link" data-field="link">
      VIEW SOURCE
      <span aria-hidden="true">↗</span>
    </a>
    <p class="dossier-foot font-mono">
      COLLISION LOGGED
      <span data-field="coords">X 000 / Y 000</span>
    </p>
  </aside>

  <div class="scene-scanline" aria-hidden="true"></div>

  <script type="application/json" data-projects is:inline set:html={JSON.stringify(payload)}></script>
  <script>
    import { initSpaceScene } from '../../scripts/space-scene';
    initSpaceScene();
  </script>
</section>
