---
import { projects } from '../data/projects';
import { site } from '../data/site';
import { getHomeCopy, type Locale } from '../i18n/home';
import ProjectCard from './ProjectCard.astro';

interface Props {
  locale?: Locale;
}

const { locale = 'zh' } = Astro.props;
const copy = getHomeCopy(locale).project;
---

<div class="grid gap-3.5 md:grid-cols-2">
  {projects.map((project, index) => (
    <div class:list={[(index === 0 || index === projects.length - 1) && 'md:col-span-2']}>
      <ProjectCard project={project} index={index} featured={index === 0} locale={locale} />
    </div>
  ))}

  <a
    href={site.github}
    target="_blank"
    rel="noreferrer"
    class="more-signals group relative flex min-h-[13rem] flex-col justify-between overflow-hidden rounded-2xl border border-dashed border-white/12 bg-white/[0.02] p-6 transition-colors hover:border-hud/40 hover:bg-hud/[0.035] md:col-span-2"
  >
    <span class="pointer-events-none absolute -right-16 -bottom-20 size-64 rounded-full border border-hud/10"></span>
    <span class="pointer-events-none absolute -right-8 -bottom-12 size-40 rounded-full border border-dashed border-hud/15"></span>
    <div class="flex items-start justify-between gap-6">
      <div>
        <p class="font-mono text-[0.72rem] tracking-[0.2em] text-hud/70">MORE SIGNALS // GITHUB</p>
        <p class="mt-3 text-xl font-medium tracking-[-0.02em] text-ink md:text-2xl">{copy.moreTitle}</p>
        <p class="mt-2 max-w-lg text-sm leading-7 text-ink-dim">{copy.moreBody}</p>
      </div>
      <span class="grid size-11 shrink-0 place-items-center rounded-full border border-white/12 text-ink-dim transition-all group-hover:border-hud/40 group-hover:text-hud">
        <svg viewBox="0 0 16 16" class="size-4" fill="none" aria-hidden="true">
          <path d="M3.5 12.5 12.5 3.5M5.5 3.5h7v7" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
    </div>
    <p class="mt-7 font-mono text-[0.72rem] tracking-[0.12em] text-ink-faint">
      {copy.moreLabel} <span class="mx-2 text-hud/40">/</span> {copy.repositories}
    </p>
  </a>
</div>
