---
import BaseLayout from './BaseLayout.astro';
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';

interface Props {
  title: string;
  description: string;
  eyebrow?: string;
}

const { title, description, eyebrow = 'ORDERKEEPER // LEGAL' } = Astro.props;
---

<BaseLayout title={`${title} · OrderKeeper（单掌柜）`} description={description}>
  <Nav />
  <main id="main" class="relative min-h-screen overflow-hidden pt-[var(--nav-height)]">
    <div class="pointer-events-none absolute inset-0 -z-10">
      <div class="absolute top-0 left-1/2 h-[30rem] w-[40rem] -translate-x-1/2 -translate-y-1/3 rounded-full bg-hud/[0.055] blur-[110px]"></div>
      <div class="absolute inset-0 bg-[linear-gradient(rgba(233,237,255,.022)_1px,transparent_1px),linear-gradient(90deg,rgba(233,237,255,.022)_1px,transparent_1px)] bg-[size:72px_72px] [mask-image:linear-gradient(to_bottom,black,transparent_70%)]"></div>
    </div>

    <article class="shell max-w-4xl py-14 md:py-20">
      <a href="/orderkeeper/" class="group inline-flex items-center gap-2 font-mono text-[0.76rem] tracking-[0.14em] text-ink-faint transition-colors hover:text-hud">
        <span class="transition-transform group-hover:-translate-x-0.5">←</span> ORDERKEEPER
      </a>

      <header class="mt-10 border-b border-white/8 pb-10">
        <p class="font-mono text-[0.72rem] tracking-[0.12em] text-ink-faint">{eyebrow}</p>
        <h1 class="mt-6 text-balance text-4xl font-medium leading-[1.08] tracking-[-0.05em] text-ink md:text-5xl">
          {title}
        </h1>
        <p class="mt-5 max-w-2xl text-base leading-8 text-ink-dim">{description}</p>
      </header>

      <div class="prose-cosmic mt-10">
        <slot />
      </div>
    </article>
  </main>
  <Footer />
</BaseLayout>
