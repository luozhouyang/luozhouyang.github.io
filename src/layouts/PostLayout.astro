---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import { formatDate } from '../lib/format';

interface Props {
  post: CollectionEntry<'blog'>;
  prev?: CollectionEntry<'blog'>;
  next?: CollectionEntry<'blog'>;
}

const { post, prev, next } = Astro.props;
const url = new URL(`/blog/${post.id}/`, Astro.site ?? Astro.url).toString();
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  author: {
    '@type': 'Organization',
    name: 'LOST IN ORBIT',
  },
  mainEntityOfPage: url,
};
---

<BaseLayout title={`${post.data.title} · LOST IN ORBIT`} description={post.data.description}>
  <Nav />
  <main id="main" class="relative min-h-screen overflow-hidden pt-[var(--nav-height)]">
    <div class="pointer-events-none absolute inset-0 -z-10">
      <div class="absolute top-0 left-1/2 h-[30rem] w-[40rem] -translate-x-1/2 -translate-y-1/3 rounded-full bg-hud/[0.055] blur-[110px]"></div>
      <div class="absolute inset-0 bg-[linear-gradient(rgba(233,237,255,.022)_1px,transparent_1px),linear-gradient(90deg,rgba(233,237,255,.022)_1px,transparent_1px)] bg-[size:72px_72px] [mask-image:linear-gradient(to_bottom,black,transparent_70%)]"></div>
    </div>

    <article class="shell max-w-4xl py-14 md:py-20">
      <a href="/blog/" class="group inline-flex items-center gap-2 font-mono text-[0.76rem] tracking-[0.14em] text-ink-faint transition-colors hover:text-hud">
        <span class="transition-transform group-hover:-translate-x-0.5">←</span> ALL TRANSMISSIONS
      </a>

      <header class="mt-10 border-b border-white/8 pb-10">
        <div class="flex flex-wrap items-center gap-x-4 gap-y-2 font-mono text-[0.72rem] tracking-[0.12em] text-ink-faint">
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          <span class="size-1 rounded-full bg-hud/50"></span>
          <span>LOG // {post.id.toUpperCase()}</span>
        </div>
        <h1 class="mt-6 text-balance text-4xl font-medium leading-[1.08] tracking-[-0.05em] text-ink md:text-6xl">
          {post.data.title}
        </h1>
        <p class="mt-5 max-w-2xl text-base leading-8 text-ink-dim">{post.data.description}</p>
        <div class="mt-6 flex flex-wrap gap-2">
          {post.data.tags.map((tag) => (
            <span class="rounded-full border border-hud/15 bg-hud/[0.035] px-3 py-1 font-mono text-[0.68rem] tracking-[0.06em] text-hud/80">{tag}</span>
          ))}
        </div>
      </header>

      <div class="prose-cosmic mt-10">
        <slot />
      </div>

      <nav class="mt-16 grid gap-3 border-t border-white/8 pt-6 sm:grid-cols-2" aria-label="文章导航">
        {prev ? (
          <a href={`/blog/${prev.id}/`} class="group rounded-2xl border border-white/8 p-5 transition-colors hover:border-hud/25 hover:bg-white/[0.02]">
            <span class="font-mono text-[0.68rem] tracking-[0.14em] text-ink-faint">← PREVIOUS</span>
            <span class="mt-2 block text-sm font-medium text-ink group-hover:text-hud">{prev.data.title}</span>
          </a>
        ) : (
          <span></span>
        )}
        {next ? (
          <a href={`/blog/${next.id}/`} class="group rounded-2xl border border-white/8 p-5 text-right transition-colors hover:border-hud/25 hover:bg-white/[0.02]">
            <span class="font-mono text-[0.68rem] tracking-[0.14em] text-ink-faint">NEXT →</span>
            <span class="mt-2 block text-sm font-medium text-ink group-hover:text-hud">{next.data.title}</span>
          </a>
        ) : (
          <span></span>
        )}
      </nav>
    </article>
  </main>
  <Footer />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</BaseLayout>
